# Archivos temporales de Office y del sistema operativo
~$*
*.tmp
.DS_Store
Thumbs.db

# Configuracion local de la maquina. Se ignora cualquier carpeta oculta de la
# raiz: ninguna forma parte del sistema y cada equipo crea las suyas.
/.*/

# Dependencias y entorno (fase de construcción)
node_modules/
__pycache__/
*.pyc
.env
.venv/
venv/
env/

# Django
*.log
db.sqlite3
staticfiles/
media/

# Compilación del frontend
dist/
build/

# Carpeta de trabajo del autor: borradores, material de estudio, generadores de
# los documentos y credenciales de prueba. No forma parte del sistema.
_interno/
