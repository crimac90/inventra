# Variables de entorno del backend de INVENTRA.
# Copiar este archivo como .env y completar los valores reales.
# El archivo .env NO se sube al repositorio: contiene credenciales.

# Clave criptográfica de Django. Se genera una distinta para cada instalación.
DJANGO_SECRET_KEY=

# Modo de depuración. True solo en desarrollo; False en el servidor publicado.
DJANGO_DEBUG=True

# Direcciones desde las que se permite servir la aplicación, separadas por coma.
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Conexión con MySQL.
DB_NOMBRE=inventra
DB_USUARIO=inventra_app
DB_CONTRASENA=
DB_HOST=127.0.0.1
DB_PUERTO=3306

# Dirección del frontend autorizada a consumir la API.
CORS_ORIGENES=http://localhost:5173

# Dirección del frontend. El enlace de recuperación de contraseña apunta aquí.
FRONTEND_URL=http://localhost:5173

# Correo saliente. En desarrollo se deja el valor de consola: los mensajes se
# imprimen en la terminal del servidor en lugar de enviarse. En el servidor
# publicado se cambia a django.core.mail.backends.smtp.EmailBackend y se
# completan los cinco valores siguientes con los datos del proveedor.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_SERVIDOR=
EMAIL_PUERTO=587
EMAIL_TLS=True
EMAIL_USUARIO=
EMAIL_CONTRASENA=
EMAIL_REMITENTE=INVENTRA <no-responder@inventra.co>
